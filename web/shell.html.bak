<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Battle Arena</title>
<style>
  :root{--accent:#00e0ff;--accent2:#ff8a1e;--panel:rgba(14,20,34,.72);
    --border:rgba(0,224,255,.35);--text:#e8f1ff;}
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;height:100%;background:#070a12;color:var(--text);
    font-family:"Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
    overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:none;}
  #canvas{position:fixed;inset:0;width:100vw;height:100vh;display:block}
  #vignette{position:fixed;inset:0;pointer-events:none;
    background:radial-gradient(ellipse at 70% 55%, rgba(0,224,255,.10), transparent 55%),
      radial-gradient(ellipse at 50% 100%, rgba(255,138,30,.08), transparent 60%),
      radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.65) 100%);}
  #home{position:fixed;inset:0;pointer-events:none;
    display:grid;grid-template-rows:auto 1fr auto;gap:12px;
    padding:clamp(10px,2vw,24px);
    padding-top:max(clamp(10px,2vw,24px), env(safe-area-inset-top));
    padding-bottom:max(clamp(10px,2vw,24px), env(safe-area-inset-bottom));}
  #home button, #home .card{pointer-events:auto}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:12px;
    padding:8px 12px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    box-shadow:0 4px 20px rgba(0,0,0,.4), inset 0 0 20px rgba(0,224,255,.05);}
  .topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
  .player{display:flex;align-items:center;gap:10px;min-width:0}
  .avatar{width:42px;height:42px;border-radius:10px;flex:0 0 auto;
    background:linear-gradient(135deg,#00e0ff,#0077ff);display:grid;place-items:center;
    font-weight:800;color:#001018;box-shadow:0 0 12px rgba(0,224,255,.5);}
  .pinfo{display:flex;flex-direction:column;min-width:0}
  .pname{font-weight:700;font-size:14px;letter-spacing:.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .plevel{font-size:11px;color:#7fd4ff;letter-spacing:1px;text-transform:uppercase}
  .currencies{display:flex;gap:8px}
  .curr{display:flex;align-items:center;gap:6px;font-weight:600;font-size:13px;padding:6px 12px}
  .curr svg{width:16px;height:16px}
  .middle{display:grid;grid-template-columns:minmax(220px,320px) 1fr;align-items:center;gap:20px}
  .menu{display:flex;flex-direction:column;gap:12px}
  .btn{appearance:none;cursor:pointer;border:1px solid var(--border);border-radius:10px;
    background:linear-gradient(180deg,rgba(20,30,50,.85),rgba(10,16,28,.85));
    color:var(--text);padding:14px 20px;font-size:15px;font-weight:700;
    letter-spacing:2px;text-transform:uppercase;display:flex;align-items:center;gap:12px;
    text-align:left;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
    box-shadow:0 4px 16px rgba(0,0,0,.4), inset 0 0 12px rgba(0,224,255,.06);
    transition:transform .08s ease, box-shadow .15s ease, border-color .15s ease;}
  .btn .ico{width:22px;height:22px;display:grid;place-items:center;flex:0 0 auto}
  .btn .ico svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .btn:hover{border-color:var(--accent);box-shadow:0 6px 24px rgba(0,224,255,.35), inset 0 0 18px rgba(0,224,255,.15)}
  .btn:active{transform:translateY(1px) scale(.99)}
  .btn.primary{background:linear-gradient(180deg,#00c8ff,#0066cc);color:#001018;border-color:#7ff0ff;
    padding:20px 24px;font-size:20px;letter-spacing:4px;
    box-shadow:0 8px 32px rgba(0,224,255,.55), inset 0 0 24px rgba(255,255,255,.35);}
  .btn.primary:hover{transform:translateY(-1px);box-shadow:0 10px 40px rgba(0,224,255,.8), inset 0 0 28px rgba(255,255,255,.5)}
  .dock{display:flex;justify-content:center;align-items:flex-end;
    gap:clamp(6px,1.2vw,14px);position:relative;pointer-events:none;padding-bottom:4px;}
  .dock-item{pointer-events:auto;cursor:pointer;display:flex;flex-direction:column;
    align-items:center;gap:6px;background:transparent;border:0;padding:0;color:var(--text);font-family:inherit;}
  .dock-item .circle{position:relative;width:clamp(44px,5.4vw,58px);height:clamp(44px,5.4vw,58px);
    border-radius:50%;background:radial-gradient(circle at 50% 25%, rgba(0,224,255,.18), transparent 60%),
      linear-gradient(180deg,rgba(20,30,50,.95),rgba(8,12,22,.95));
    border:1px solid var(--border);display:grid;place-items:center;
    box-shadow:0 4px 16px rgba(0,0,0,.55), inset 0 0 14px rgba(0,224,255,.08);
    transition:transform .12s ease, box-shadow .15s ease, border-color .15s ease;}
  .dock-item:hover .circle{border-color:var(--accent);
    box-shadow:0 6px 22px rgba(0,224,255,.4), inset 0 0 18px rgba(0,224,255,.2);
    transform:translateY(-2px);}
  .dock-item:active .circle{transform:translateY(0) scale(.96)}
  .dock-item .circle svg{width:52%;height:52%;stroke:#bfeaff;fill:none;
    stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;
    filter:drop-shadow(0 0 4px rgba(0,224,255,.35));}
  .dock-item .label{font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;opacity:.75}
  .dock-item.featured .circle{border-color:#7ff0ff;
    background:radial-gradient(circle at 50% 25%, rgba(255,255,255,.25), transparent 55%),
      linear-gradient(180deg,#00c8ff,#0066cc);
    box-shadow:0 8px 26px rgba(0,224,255,.6), inset 0 0 22px rgba(255,255,255,.4);}
  .dock-item.featured .circle svg{stroke:#001018;filter:none}
  .dock-item.featured .label{opacity:1;color:#7ff0ff}
  .badge{position:absolute;top:-2px;right:-2px;min-width:18px;height:18px;padding:0 4px;
    border-radius:9px;background:#ff3b5c;color:#fff;font:700 10px/18px system-ui;
    text-align:center;border:1.5px solid #0b0e14;box-shadow:0 0 8px rgba(255,59,92,.7);}
  .ver{position:absolute;right:0;bottom:-14px;font-size:11px;opacity:.55;letter-spacing:1px}
  #hint{position:fixed;left:50%;bottom:130px;transform:translateX(-50%);
    padding:8px 16px;border-radius:20px;font:600 12px/1 system-ui;letter-spacing:2px;
    text-transform:uppercase;color:#9fe8ff;background:rgba(0,224,255,.08);
    border:1px solid rgba(0,224,255,.35);pointer-events:none;opacity:0;transition:opacity .6s;z-index:9;}
  .panel-overlay{position:fixed;inset:0;z-index:50;background:rgba(2,4,10,.66);
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    display:flex;align-items:center;justify-content:center;padding:20px;
    opacity:0;transition:opacity .2s ease;pointer-events:auto;}
  .panel-overlay[hidden]{display:none}
  .panel-overlay.show{opacity:1}
  .panel{width:min(760px,100%);max-height:min(84vh,680px);
    background:linear-gradient(180deg, rgba(14,20,34,.97), rgba(8,12,20,.99));
    border:1px solid var(--border);border-radius:16px;
    box-shadow:0 20px 60px rgba(0,0,0,.75), inset 0 0 40px rgba(0,224,255,.05);
    display:flex;flex-direction:column;transform:translateY(10px) scale(.98);transition:transform .22s ease;}
  .panel-overlay.show .panel{transform:none}
  .panel-head{display:flex;justify-content:space-between;align-items:center;
    padding:16px 20px;border-bottom:1px solid rgba(0,224,255,.15);}
  .panel-title{font-size:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase}
  .panel-sub{font-size:11px;color:#7fd4ff;letter-spacing:1.2px;margin-top:3px}
  .panel-close{width:36px;height:36px;border-radius:50%;background:rgba(0,224,255,.08);
    border:1px solid var(--border);color:var(--text);cursor:pointer;
    display:grid;place-items:center;transition:all .15s;}
  .panel-close:hover{background:rgba(0,224,255,.18);border-color:var(--accent)}
  .panel-close svg{width:16px;height:16px}
  .panel-body{padding:16px 20px;overflow-y:auto;flex:1}
  .panel-body::-webkit-scrollbar{width:8px}
  .panel-body::-webkit-scrollbar-thumb{background:rgba(0,224,255,.22);border-radius:4px}
  .panel-foot{padding:12px 20px;border-top:1px solid rgba(0,224,255,.15);
    display:flex;gap:10px;justify-content:flex-end}
  .panel-foot button{padding:10px 22px;border-radius:8px;font-weight:700;letter-spacing:2px;
    text-transform:uppercase;font-size:12px;cursor:pointer;font-family:inherit;
    border:1px solid var(--border);background:rgba(0,224,255,.06);color:var(--text);transition:all .15s;}
  .panel-foot button:hover{background:rgba(0,224,255,.16);border-color:var(--accent)}
  .panel-foot button.primary{background:linear-gradient(180deg,#00c8ff,#0066cc);color:#001018;border-color:#7ff0ff}
  .panel-foot button.primary:hover{filter:brightness(1.1)}
  .item-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(120px, 1fr));gap:12px}
  .item-card{background:linear-gradient(180deg, rgba(22,32,52,.92), rgba(10,14,24,.92));
    border:1px solid rgba(0,224,255,.18);border-radius:12px;padding:12px;
    display:flex;flex-direction:column;gap:8px;align-items:center;cursor:pointer;
    color:inherit;font-family:inherit;position:relative;overflow:hidden;
    transition:transform .12s, box-shadow .15s, border-color .15s;}
  .item-card:hover{transform:translateY(-2px);border-color:var(--accent);
    box-shadow:0 6px 22px rgba(0,224,255,.35)}
  .item-card.selected{border-color:#7ff0ff;
    box-shadow:0 8px 26px rgba(0,224,255,.6), inset 0 0 18px rgba(0,224,255,.2)}
  .item-card.selected::after{content:"EQUIPPED";position:absolute;top:6px;right:-28px;
    background:#00c8ff;color:#001018;font:800 9px/14px system-ui;padding:2px 30px;
    letter-spacing:1.5px;transform:rotate(38deg);}
  .item-card.owned::before{content:"OWNED";position:absolute;top:6px;left:-24px;
    background:#22c55e;color:#04130a;font:800 9px/14px system-ui;padding:2px 26px;
    letter-spacing:1.5px;transform:rotate(-38deg);}
  .item-thumb{width:100%;aspect-ratio:1/1;border-radius:8px;display:grid;place-items:center;
    background:radial-gradient(circle at 50% 35%, rgba(0,224,255,.12), transparent 65%)}
  .item-thumb svg{width:78%;height:78%}
  .item-name{font-size:12px;font-weight:700;text-align:center;line-height:1.2}
  .item-sub{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;opacity:.8}
  .rar-common .item-sub{color:#9fb0c8}
  .rar-rare .item-sub{color:#5ec8ff}
  .rar-epic .item-sub{color:#b085ff}
  .rar-legendary .item-sub{color:#ffc857}
  .rar-mythic .item-sub{color:#ff7ab6}
  .row-list{display:flex;flex-direction:column;gap:10px}
  .row{display:flex;align-items:center;gap:14px;padding:12px 14px;border-radius:12px;
    background:linear-gradient(180deg, rgba(22,32,52,.9), rgba(10,14,24,.9));
    border:1px solid rgba(0,224,255,.15);}
  .row .icon{width:44px;height:44px;border-radius:10px;flex:0 0 auto;
    background:linear-gradient(135deg,#00e0ff,#0077ff);
    display:grid;place-items:center;color:#001018;font-weight:800}
  .row .icon svg{width:60%;height:60%}
  .row .info{flex:1;min-width:0}
  .row .rname{font-size:13px;font-weight:700;letter-spacing:.4px}
  .row .rsub{font-size:11px;color:#7fd4ff;letter-spacing:1px;margin-top:2px}
  .row .rright{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;opacity:.75}
  .row .rright.new{color:#ff3b5c;opacity:1}
  .row .rright.claim{color:#7ff0ff;opacity:1;font-weight:700}
  .row .rright.claimed{color:#22c55e;opacity:1;font-weight:700}
  .row.empty{opacity:.55;border-style:dashed}
  .row.empty .icon{background:rgba(0,224,255,.08);border:1px dashed rgba(0,224,255,.4)}
  @media (max-width:720px){
    .middle{grid-template-columns:1fr}
    .menu{max-width:320px}
    .btn{padding:12px 16px;font-size:13px}
    .btn.primary{font-size:17px;letter-spacing:3px;padding:16px 20px}
    .curr{padding:5px 10px;font-size:12px}
    .pname{font-size:13px}
    .avatar{width:36px;height:36px;font-size:14px}
    .dock-item .label{font-size:9px;letter-spacing:1px}
    #hint{bottom:110px}
    .item-grid{grid-template-columns:repeat(auto-fill, minmax(96px,1fr));gap:8px}
    .item-card{padding:8px}
    .item-name{font-size:11px}
  }
</style>
</head>
<body>
  <canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
  <div id="vignette"></div>

  <div id="home">
    <div class="topbar">
      <div class="card player">
        <div class="avatar">P1</div>
        <div class="pinfo">
          <div class="pname">Player_001</div>
          <div class="plevel">Level 12</div>
        </div>
      </div>
      <div class="currencies">
        <div class="card curr" title="Diamonds">
          <svg viewBox="0 0 24 24" fill="#7ff0ff"><path d="M12 2 4 9l8 13 8-13z"/></svg>
          <span id="uiDiamonds">320</span>
        </div>
        <div class="card curr" title="Coins">
          <svg viewBox="0 0 24 24" fill="#ffd166"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5" fill="#c98f2b"/></svg>
          <span id="uiCoins">1,250</span>
        </div>
      </div>
    </div>

    <div class="middle">
      <div class="menu">
        <button class="btn primary" id="btnPlay">
          <span class="ico"><svg viewBox="0 0 24 24"><polygon points="6,4 20,12 6,20" fill="currentColor" stroke="none"/></svg></span>
          Play
        </button>
        <button class="btn" data-panel="weapons">
          <span class="ico"><svg viewBox="0 0 24 24"><path d="M3 14l6-6 3 3-3 3z"/><path d="M9 11l8-8 4 4-8 8"/><path d="M7 16l3 3"/></svg></span>
          Loadout
        </button>
        <button class="btn" data-panel="store">
          <span class="ico"><svg viewBox="0 0 24 24"><path d="M4 8h16l-1 12H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span>
          Store
        </button>
        <button class="btn" id="btnSettings">
          <span class="ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg></span>
          Settings
        </button>
      </div>
      <div></div>
    </div>

    <div class="dock" id="dock">
      <button class="dock-item" data-panel="inventory" title="Inventory">
        <span class="circle">
          <svg viewBox="0 0 24 24"><path d="M5 8h14v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/><path d="M5 13h14"/></svg>
          <span class="badge" id="badgeBag">3</span>
        </span>
        <span class="label">Bag</span>
      </button>
      <button class="dock-item" data-panel="weapons" title="Weapons">
        <span class="circle">
          <svg viewBox="0 0 24 24"><path d="M3 14l6-6 3 3-3 3z"/><path d="M9 11l8-8 4 4-8 8"/><path d="M7 16l3 3"/></svg>
        </span>
        <span class="label">Weapons</span>
      </button>
      <button class="dock-item featured" data-panel="character" title="Character">
        <span class="circle">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        </span>
        <span class="label">Character</span>
      </button>
      <button class="dock-item" data-panel="pet" title="Pet">
        <span class="circle">
          <svg viewBox="0 0 24 24"><circle cx="7" cy="9" r="2.2"/><circle cx="12" cy="6.5" r="2.2"/><circle cx="17" cy="9" r="2.2"/><path d="M12 21c-3.2 0-5.5-2-5.5-4.4 0-1.6 1.3-2.6 3-2.6h5c1.7 0 3 1 3 2.6C17.5 19 15.2 21 12 21z"/></svg>
        </span>
        <span class="label">Pet</span>
      </button>
      <button class="dock-item" data-panel="store" title="Store">
        <span class="circle">
          <svg viewBox="0 0 24 24"><path d="M4 8h16l-1 12H5z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        </span>
        <span class="label">Store</span>
      </button>
      <button class="dock-item" data-panel="team" title="Team">
        <span class="circle">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="3"/><circle cx="17" cy="10" r="2.2"/><path d="M3 20c0-3 3-5 6-5s6 2 6 5"/><path d="M15 20c0-2 2-3.5 4-3.5s2.5 1 2.5 3.5"/></svg>
        </span>
        <span class="label">Team</span>
      </button>
      <button class="dock-item" data-panel="mail" title="Mail">
        <span class="circle">
          <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 8l9 6 9-6"/></svg>
          <span class="badge" id="badgeMail">1</span>
        </span>
        <span class="label">Mail</span>
      </button>
      <span class="ver">v0.1.0</span>
    </div>
  </div>

  <div id="hint">Drag to rotate</div>

  <div class="panel-overlay" id="panelOverlay" hidden>
    <div class="panel" id="panelBox">
      <div class="panel-head">
        <div>
          <div class="panel-title" id="panelTitle">Bag</div>
          <div class="panel-sub" id="panelSub"></div>
        </div>
        <button class="panel-close" id="panelClose" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="panel-body" id="panelBody"></div>
      <div class="panel-foot" id="panelFoot"></div>
    </div>
  </div>

  <script>
    var DB = {
      get: function(k, d){ try{ var v = localStorage.getItem(k); return v===null ? d : JSON.parse(v); } catch(e){ return d; } },
      set: function(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
    };

    function svgBag(c){ return '<svg viewBox="0 0 48 48">'
      +'<rect x="8" y="14" width="32" height="26" rx="6" fill="'+c+'" opacity=".9"/>'
      +'<path d="M16 14v-3a8 8 0 0 1 16 0v3" stroke="'+c+'" stroke-width="3" fill="none" stroke-linecap="round"/>'
      +'<rect x="18" y="23" width="12" height="8" rx="2" fill="rgba(255,255,255,.4)"/>'
      +'<rect x="21" y="35" width="6" height="3" rx="1.5" fill="rgba(0,0,0,.45)"/>'
      +'<rect x="5" y="22" width="4" height="10" rx="2" fill="'+c+'" opacity=".7"/>'
      +'<rect x="39" y="22" width="4" height="10" rx="2" fill="'+c+'" opacity=".7"/></svg>'; }
    function svgWeapon(c,kind){
      if(kind==='sniper') return '<svg viewBox="0 0 48 48">'
        +'<rect x="4" y="22" width="40" height="5" rx="2" fill="'+c+'"/>'
        +'<rect x="18" y="16" width="12" height="6" rx="1" fill="'+c+'" opacity=".7"/>'
        +'<circle cx="40" cy="24.5" r="4" fill="'+c+'"/>'
        +'<rect x="12" y="27" width="5" height="12" rx="2" fill="'+c+'" opacity=".8"/>'
        +'<rect x="20" y="27" width="4" height="9" rx="1.5" fill="'+c+'" opacity=".6"/></svg>';
      if(kind==='smg') return '<svg viewBox="0 0 48 48">'
        +'<rect x="8" y="22" width="26" height="8" rx="2" fill="'+c+'"/>'
        +'<rect x="34" y="24" width="8" height="4" rx="1" fill="'+c+'"/>'
        +'<rect x="14" y="30" width="6" height="10" rx="2" fill="'+c+'" opacity=".85"/>'
        +'<rect x="22" y="30" width="5" height="7" rx="1.5" fill="'+c+'" opacity=".6"/>'
        +'<rect x="12" y="19" width="8" height="3" rx="1" fill="'+c+'" opacity=".7"/></svg>';
      if(kind==='shotgun') return '<svg viewBox="0 0 48 48">'
        +'<rect x="4" y="20" width="34" height="6" rx="2" fill="'+c+'"/>'
        +'<rect x="4" y="27" width="34" height="5" rx="2" fill="'+c+'" opacity=".7"/>'
        +'<rect x="36" y="20" width="8" height="12" rx="2" fill="'+c+'"/>'
        +'<rect x="14" y="32" width="6" height="10" rx="2" fill="'+c+'" opacity=".85"/></svg>';
      if(kind==='pistol') return '<svg viewBox="0 0 48 48">'
        +'<rect x="12" y="18" width="22" height="8" rx="2" fill="'+c+'"/>'
        +'<rect x="32" y="20" width="4" height="4" rx="1" fill="'+c+'"/>'
        +'<path d="M14 26 L14 40 L20 40 L22 26 Z" fill="'+c+'" opacity=".85"/></svg>';
      return '<svg viewBox="0 0 48 48">'
        +'<rect x="6" y="21" width="32" height="7" rx="2" fill="'+c+'"/>'
        +'<rect x="34" y="23" width="8" height="3" rx="1" fill="'+c+'"/>'
        +'<rect x="14" y="28" width="6" height="10" rx="2" fill="'+c+'" opacity=".9"/>'
        +'<rect x="22" y="28" width="5" height="8" rx="1.5" fill="'+c+'" opacity=".65"/>'
        +'<rect x="12" y="17" width="10" height="4" rx="1" fill="'+c+'" opacity=".75"/></svg>';
    }
    function svgChar(c){ return '<svg viewBox="0 0 48 48">'
      +'<circle cx="24" cy="15" r="7" fill="'+c+'"/>'
      +'<path d="M10 42c0-8 6-13 14-13s14 5 14 13z" fill="'+c+'" opacity=".9"/>'
      +'<circle cx="21" cy="14" r="1.3" fill="#0a0d14"/>'
      +'<circle cx="27" cy="14" r="1.3" fill="#0a0d14"/>'
      +'<rect x="14" y="24" width="20" height="4" rx="2" fill="rgba(255,255,255,.35)"/></svg>'; }
    function svgPet(c,kind){
      if(kind==='bird') return '<svg viewBox="0 0 48 48">'
        +'<path d="M10 30 Q16 14 30 16 Q38 18 36 28 Q28 40 12 34 Z" fill="'+c+'"/>'
        +'<path d="M30 16 L44 20 L32 24 Z" fill="'+c+'" opacity=".8"/>'
        +'<circle cx="24" cy="22" r="1.5" fill="#0a0d14"/></svg>';
      if(kind==='wolf') return '<svg viewBox="0 0 48 48">'
        +'<path d="M8 12 L16 20 L30 20 L38 12 L36 24 Q36 38 24 40 Q12 38 12 24 Z" fill="'+c+'"/>'
        +'<circle cx="18" cy="26" r="1.5" fill="#0a0d14"/>'
        +'<circle cx="30" cy="26" r="1.5" fill="#0a0d14"/>'
        +'<path d="M22 34 L24 36 L26 34" stroke="#0a0d14" stroke-width="1.5" fill="none"/></svg>';
      if(kind==='dragon') return '<svg viewBox="0 0 48 48">'
        +'<path d="M10 26 Q14 12 26 14 Q36 16 36 26 Q34 38 24 40 Q14 38 10 26 Z" fill="'+c+'"/>'
        +'<path d="M26 14 L34 6 L32 16 Z" fill="'+c+'" opacity=".8"/>'
        +'<circle cx="20" cy="24" r="1.6" fill="#0a0d14"/>'
        +'<circle cx="30" cy="24" r="1.6" fill="#0a0d14"/></svg>';
      if(kind==='cat') return '<svg viewBox="0 0 48 48">'
        +'<path d="M12 14 L16 6 L22 14 L26 14 L32 6 L36 14 L36 30 Q36 40 24 40 Q12 40 12 30 Z" fill="'+c+'"/>'
        +'<circle cx="19" cy="24" r="1.5" fill="#0a0d14"/>'
        +'<circle cx="29" cy="24" r="1.5" fill="#0a0d14"/>'
        +'<path d="M22 30 L24 32 L26 30" stroke="#0a0d14" stroke-width="1.5" fill="none"/></svg>';
      return '<svg viewBox="0 0 48 48">'
        +'<rect x="10" y="14" width="28" height="22" rx="4" fill="'+c+'"/>'
        +'<circle cx="18" cy="24" r="3" fill="#7ff0ff"/>'
        +'<circle cx="30" cy="24" r="3" fill="#7ff0ff"/>'
        +'<rect x="20" y="32" width="8" height="6" rx="1" fill="rgba(0,0,0,.4)"/>'
        +'<rect x="6" y="18" width="4" height="10" rx="2" fill="'+c+'" opacity=".7"/>'
        +'<rect x="38" y="18" width="4" height="10" rx="2" fill="'+c+'" opacity=".7"/></svg>';
    }
    function svgStore(c){ return '<svg viewBox="0 0 48 48">'
      +'<path d="M10 16 L38 16 L34 42 L14 42 Z" fill="'+c+'"/>'
      +'<path d="M18 16 V12 a6 6 0 0 1 12 0 V16" stroke="'+c+'" stroke-width="3" fill="none"/>'
      +'<rect x="18" y="24" width="12" height="10" rx="2" fill="rgba(255,255,255,.4)"/></svg>'; }
    function svgPerson(c){ return '<svg viewBox="0 0 24 24" fill="'+c+'">'
      +'<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6z"/></svg>'; }
    function svgMail(c){ return '<svg viewBox="0 0 24 24" fill="'+c+'">'
      +'<rect x="3" y="6" width="18" height="12" rx="2"/>'
      +'<path d="M3 8l9 6 9-6" stroke="rgba(0,0,0,.5)" stroke-width="1.6" fill="none"/></svg>'; }

    var PANELS = {
      inventory: { title:'Backpacks', sub:'5 / 8 slots used',
        foot:[{label:'Close'}],
        grid: [
          {name:'Scout Pack',   sub:'Common',    color:'#7aa2c9', rar:'common'},
          {name:'Tactical Bag', sub:'Rare',      color:'#3fa9ff', rar:'rare'},
          {name:'Cyberpack',    sub:'Epic',      color:'#a970ff', rar:'epic'},
          {name:'Elite Carrier',sub:'Legendary', color:'#ffb84d', rar:'legendary'},
          {name:'Phantom Pack', sub:'Mythic',    color:'#ff5aa0', rar:'mythic'}
        ],
        type:'bag', selectable:true, storeKey:'ba_selected_bag', defaultKey:'Scout Pack' },
      weapons: { title:'Weapons', sub:'Primary loadout',
        foot:[{label:'Close'}],
        grid: [
          {name:'AR-56 Vulcan', sub:'Rare',      color:'#5ec8ff', rar:'rare',      kind:'ar'},
          {name:'MP-9 Viper',   sub:'Rare',      color:'#3fa9ff', rar:'rare',      kind:'smg'},
          {name:'AWM Reaper',   sub:'Epic',      color:'#b085ff', rar:'epic',      kind:'sniper'},
          {name:'SPAS Thunder', sub:'Epic',      color:'#a970ff', rar:'epic',      kind:'shotgun'},
          {name:'Desert Fang',  sub:'Legendary', color:'#ffc857', rar:'legendary', kind:'pistol'}
        ],
        type:'weapon', selectable:true, storeKey:'ba_selected_weapon', defaultKey:'AR-56 Vulcan' },
      character: { title:'Characters', sub:'Choose your fighter',
        foot:[{label:'Close'}],
        grid: [
          {name:'Alpha',  sub:'Starter',   color:'#4aa8ff', rar:'rare',      key:'alpha'},
          {name:'Nova',   sub:'Epic',      color:'#ff5aa0', rar:'epic',      key:'nova'},
          {name:'Ghost',  sub:'Epic',      color:'#c8d4e8', rar:'epic',      key:'ghost'},
          {name:'Blaze',  sub:'Legendary', color:'#ff8a3d', rar:'legendary', key:'blaze'},
          {name:'Shadow', sub:'Mythic',    color:'#a970ff', rar:'mythic',    key:'shadow'}
        ],
        type:'character', selectable:true, storeKey:'ba_selected_char', defaultKey:'alpha' },
      pet: { title:'Pets', sub:'Your companions',
        foot:[{label:'Close'}],
        grid: [
          {name:'Sky Falcon', sub:'Rare',      color:'#5ec8ff', rar:'rare',      kind:'bird'},
          {name:'Frost Wolf', sub:'Epic',      color:'#9fd0ff', rar:'epic',      kind:'wolf'},
          {name:'Ember Drake',sub:'Epic',      color:'#ff7a3d', rar:'epic',      kind:'dragon'},
          {name:'Lucky Cat',  sub:'Legendary', color:'#ffc857', rar:'legendary', kind:'cat'},
          {name:'Mech-01',    sub:'Mythic',    color:'#7ff0ff', rar:'mythic',    kind:'mech'}
        ],
        type:'pet', selectable:true, storeKey:'ba_selected_pet', defaultKey:'Sky Falcon' },
      store: { title:'Store', sub:'Featured items',
        foot:[{label:'Close'}],
        grid: [
          {name:'Diamond Pass', sub:'320 Diamonds', color:'#7ff0ff', rar:'rare',      price:320,  currency:'diamonds'},
          {name:'Weapon Bundle',sub:'800 Coins',    color:'#a970ff', rar:'epic',      price:800,  currency:'coins'},
          {name:'Character Box',sub:'500 Coins',    color:'#ff5aa0', rar:'mythic',    price:500,  currency:'coins'},
          {name:'Pet Crate',    sub:'400 Coins',    color:'#ffc857', rar:'legendary', price:400,  currency:'coins'},
          {name:'Elite Pass',   sub:'300 Diamonds', color:'#4aa8ff', rar:'epic',      price:300,  currency:'diamonds'}
        ],
        type:'store', buyable:true },
      team: { title:'Squad', sub:'', foot:[{label:'Close'}], dynamicRows:true },
      mail: { title:'Mail',  sub:'', foot:[{label:'Close'}], dynamicMail:true }
    };

    if (DB.get('ba_coins', null)     === null) DB.set('ba_coins', 1250);
    if (DB.get('ba_diamonds', null)  === null) DB.set('ba_diamonds', 320);
    if (DB.get('ba_owned', null)     === null) DB.set('ba_owned', []);
    if (DB.get('ba_team', null)      === null) DB.set('ba_team', []);
    if (DB.get('ba_mail_claimed',null)=== null) DB.set('ba_mail_claimed', []);
    if (DB.get('ba_selected_char',null)===null) DB.set('ba_selected_char','alpha');
    if (DB.get('ba_selected_bag',null)===null) DB.set('ba_selected_bag','Scout Pack');
    if (DB.get('ba_selected_weapon',null)===null) DB.set('ba_selected_weapon','AR-56 Vulcan');
    if (DB.get('ba_selected_pet',null)===null) DB.set('ba_selected_pet','Sky Falcon');

    var CHAR_ORDER = ['alpha','nova','ghost','blaze','shadow'];
    function applyCharTo3D(key){
      var idx = CHAR_ORDER.indexOf(key);
      if (idx < 0) idx = 0;
      (function tryApply(){
        if (window.Module && typeof Module._set_character_preset === 'function'){
          Module._set_character_preset(idx);
          console.log('[3D] char ->', key);
        } else { setTimeout(tryApply, 120); }
      })();
    }

    var PET_ORDER = ['Sky Falcon','Frost Wolf','Ember Drake','Lucky Cat','Mech-01'];
    function applyPetTo3D(name){
      var idx = PET_ORDER.indexOf(name);
      if (idx < 0) idx = 0;
      idx += 1;
      (function tryApply(){
        if (window.Module && typeof Module._set_pet_preset === 'function'){
          Module._set_pet_preset(idx);
          console.log('[3D] pet ->', name);
        } else { setTimeout(tryApply, 120); }
      })();
    }

    // Tell C++ which subject drag should rotate (0 = character, 1 = pet)
    function setActiveSubject(s){
      (function tryApply(){
        if (window.Module && typeof Module._set_active_subject === 'function'){
          Module._set_active_subject(s);
          console.log('[3D] active subject ->', s === 0 ? 'character' : 'pet');
        } else { setTimeout(tryApply, 120); }
      })();
    }

    function fmt(n){ return Number(n).toLocaleString('en-US'); }
    function updateTopbar(){
      var c = document.getElementById('uiCoins');
      var d = document.getElementById('uiDiamonds');
      if (c) c.textContent = fmt(DB.get('ba_coins', 1250));
      if (d) d.textContent = fmt(DB.get('ba_diamonds', 320));
    }

    var overlay  = document.getElementById('panelOverlay');
    var pTitle   = document.getElementById('panelTitle');
    var pSub     = document.getElementById('panelSub');
    var pBody    = document.getElementById('panelBody');
    var pFoot    = document.getElementById('panelFoot');
    var pClose   = document.getElementById('panelClose');
    var gCurrentPanel = null;

    function buildGridItem(item, type, selected, owned){
      var card = document.createElement('button');
      card.className = 'item-card rar-' + (item.rar || 'common')
        + (selected ? ' selected' : '') + (owned ? ' owned' : '');
      card.type = 'button';
      card.dataset.key = item.key || item.name;
      var svg = '';
      if (type === 'bag')            svg = svgBag(item.color);
      else if (type === 'weapon')    svg = svgWeapon(item.color, item.kind);
      else if (type === 'character') svg = svgChar(item.color);
      else if (type === 'pet')       svg = svgPet(item.color, item.kind);
      else if (type === 'store')     svg = svgStore(item.color);
      card.innerHTML =
        '<div class="item-thumb">' + svg + '</div>' +
        '<div class="item-name">' + item.name + '</div>' +
        '<div class="item-sub">' + item.sub + '</div>';
      return card;
    }

    function buildRow(row){
      var el = document.createElement('div');
      el.className = 'row' + (row.kind === 'empty' ? ' empty' : '');
      var icon = '';
      if (row.kind === 'empty')
        icon = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" fill="none" stroke="rgba(0,224,255,.5)" stroke-width="2" stroke-dasharray="3 3"/></svg>';
      else if (row.kind === 'mail') icon = svgMail('#7ff0ff');
      else icon = svgPerson('#001018');
      var right = '';
      if (row.right){
        var cls = row.claim ? ' claim' : (row.isnew ? ' new' : (row.claimed ? ' claimed' : ''));
        right = '<div class="rright' + cls + '">' + row.right + '</div>';
      }
      el.innerHTML =
        '<div class="icon">' + icon + '</div>' +
        '<div class="info"><div class="rname">' + (row.name || 'Empty') + '</div>' +
        '<div class="rsub">' + (row.sub || '') + '</div></div>' + right;
      return el;
    }

    function renderPanel(){
      var id = gCurrentPanel;
      if (!id) return;
      var cfg = PANELS[id];
      pBody.innerHTML = '';
      pFoot.innerHTML = '';

      if (cfg.grid){
        var grid = document.createElement('div');
        grid.className = 'item-grid';
        var selKey = cfg.storeKey ? DB.get(cfg.storeKey, cfg.defaultKey) : null;
        var owned = DB.get('ba_owned', []);

        cfg.grid.forEach(function(item){
          var isSel = selKey && (item.key || item.name) === selKey;
          var isOwned = cfg.buyable && owned.indexOf(item.name) >= 0;
          var card = buildGridItem(item, cfg.type, isSel, isOwned);

          card.addEventListener('click', function(){
            if (cfg.buyable){
              if (owned.indexOf(item.name) >= 0) return;
              var wallet = DB.get('ba_' + item.currency, 0);
              if (wallet < item.price){
                card.animate([{transform:'translateX(0)'},{transform:'translateX(-4px)'},
                              {transform:'translateX(4px)'},{transform:'translateX(0)'}],
                             {duration:200});
                return;
              }
              DB.set('ba_' + item.currency, wallet - item.price);
              owned.push(item.name);
              DB.set('ba_owned', owned);
              updateTopbar();
              renderPanel();
              return;
            }
            if (cfg.selectable && cfg.storeKey){
              DB.set(cfg.storeKey, item.key || item.name);
              if (id === 'character') applyCharTo3D(item.key);
              if (id === 'pet')       applyPetTo3D(item.name);
              renderPanel();
            }
          });
          grid.appendChild(card);
        });
        pBody.appendChild(grid);
      }

      if (cfg.dynamicRows){
        var team = DB.get('ba_team', []);
        var rows = [{name:'Player_001 (You)', sub:'Level 12 . Ready', kind:'you'}];
        for (var i = 0; i < 3; i++){
          if (team[i]) rows.push({name: team[i].name, sub: team[i].sub || 'Level 1', kind:'you'});
          else rows.push({name:'', sub:'Empty slot', kind:'empty'});
        }
        var list = document.createElement('div');
        list.className = 'row-list';
        rows.forEach(function(r){ list.appendChild(buildRow(r)); });
        pBody.appendChild(list);
        pSub.textContent = (1 + team.length) + ' / 4 in team';

        var inviteBtn = document.createElement('button');
        inviteBtn.type = 'button';
        inviteBtn.className = 'primary';
        inviteBtn.textContent = 'Invite';
        inviteBtn.addEventListener('click', function(){
          if (team.length >= 3) return;
          var name = window.prompt('Friend name?', 'Player_' + (1000 + Math.floor(Math.random()*8999)));
          if (!name) return;
          team.push({name:name, sub:'Level ' + (1 + Math.floor(Math.random()*40))});
          DB.set('ba_team', team);
          renderPanel();
        });
        pFoot.appendChild(inviteBtn);
      }

      if (cfg.dynamicMail){
        var mails = [
          {name:'Welcome Reward',  sub:'Thanks for joining',  reward:{coins:200}},
          {name:'Daily Login',     sub:'Day 5 reward ready',  reward:{coins:150}},
          {name:'Season 3 Notice', sub:'New season starts',   reward:{diamonds:50}}
        ];
        var claimed = DB.get('ba_mail_claimed', []);
        var unread = 0;
        var list = document.createElement('div');
        list.className = 'row-list';
        mails.forEach(function(m){
          var isClaimed = claimed.indexOf(m.name) >= 0;
          if (!isClaimed) unread++;
          var row = buildRow({
            name: m.name, sub: m.sub, kind:'mail',
            right: isClaimed ? 'Claimed' : 'Claim',
            claim: !isClaimed, claimed: isClaimed
          });
          row.style.cursor = isClaimed ? 'default' : 'pointer';
          row.addEventListener('click', function(){
            if (claimed.indexOf(m.name) >= 0) return;
            if (m.reward.coins)    DB.set('ba_coins', DB.get('ba_coins',0) + m.reward.coins);
            if (m.reward.diamonds) DB.set('ba_diamonds', DB.get('ba_diamonds',0) + m.reward.diamonds);
            claimed.push(m.name);
            DB.set('ba_mail_claimed', claimed);
            updateTopbar();
            renderPanel();
            refreshBadges();
          });
          list.appendChild(row);
        });
        pBody.appendChild(list);
        pSub.textContent = unread + ' unread';

        var claimAll = document.createElement('button');
        claimAll.type = 'button';
        claimAll.className = 'primary';
        claimAll.textContent = 'Claim All';
        claimAll.addEventListener('click', function(){
          var c2 = DB.get('ba_mail_claimed', []);
          mails.forEach(function(m){
            if (c2.indexOf(m.name) >= 0) return;
            if (m.reward.coins)    DB.set('ba_coins', DB.get('ba_coins',0) + m.reward.coins);
            if (m.reward.diamonds) DB.set('ba_diamonds', DB.get('ba_diamonds',0) + m.reward.diamonds);
            c2.push(m.name);
          });
          DB.set('ba_mail_claimed', c2);
          updateTopbar();
          renderPanel();
          refreshBadges();
        });
        pFoot.appendChild(claimAll);
      }

      if (cfg.foot){
        cfg.foot.forEach(function(b){
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = b.cls || '';
          btn.textContent = b.label;
          btn.addEventListener('click', function(){
            if (b.label === 'Close') closePanel();
          });
          pFoot.appendChild(btn);
        });
      }
    }

    function refreshBadges(){
      var unread = 3 - Math.min(3, DB.get('ba_mail_claimed', []).length);
      var mb = document.getElementById('badgeMail');
      if (mb){
        if (unread > 0){ mb.style.display = ''; mb.textContent = unread; }
        else mb.style.display = 'none';
      }
    }

    function openPanel(id){
      if (!PANELS[id]) return;
      gCurrentPanel = id;
      pTitle.textContent = PANELS[id].title;
      pSub.textContent   = PANELS[id].sub || '';

      // ---- Tell C++ which subject drag should rotate ----
      if (id === 'character') setActiveSubject(0);
      else if (id === 'pet')  setActiveSubject(1);
      else                    setActiveSubject(0);  // default = character

      renderPanel();
      overlay.hidden = false;
      requestAnimationFrame(function(){ overlay.classList.add('show'); });
    }
    function closePanel(){
      overlay.classList.remove('show');
      setTimeout(function(){ overlay.hidden = true; gCurrentPanel = null; }, 200);
    }

    pClose.addEventListener('click', closePanel);
    overlay.addEventListener('click', function(e){
      if (e.target === overlay) closePanel();
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !overlay.hidden) closePanel();
    });

    (function(){
      var c = document.getElementById('canvas');
      function fit(){ c.width = window.innerWidth; c.height = window.innerHeight; }
      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('orientationchange', fit);
      var hint = document.getElementById('hint');
      setTimeout(function(){ hint.style.opacity = '1'; }, 400);
      setTimeout(function(){ hint.style.opacity = '0'; }, 3500);
      function hideHint(){ hint.style.opacity = '0'; }
      window.addEventListener('mousedown',  hideHint);
      window.addEventListener('touchstart', hideHint);
    })();

    window.addEventListener('DOMContentLoaded', function(){
      updateTopbar();
      refreshBadges();
      applyCharTo3D(DB.get('ba_selected_char','alpha'));
      applyPetTo3D(DB.get('ba_selected_pet','Sky Falcon'));
      setActiveSubject(0);  // default = character drag

      document.querySelectorAll('[data-panel]').forEach(function(btn){
        btn.addEventListener('click', function(){
          openPanel(btn.getAttribute('data-panel'));
        });
      });
      var playBtn = document.getElementById('btnPlay');
      if (playBtn) playBtn.addEventListener('click', function(){ console.log('PLAY'); });
      var setBtn = document.getElementById('btnSettings');
      if (setBtn) setBtn.addEventListener('click', function(){ console.log('SETTINGS'); });
    });
  </script>
  {{{ SCRIPT }}}
</body>
</html>
